#!/usr/bin/php
<?php
# Pulsed Media Seedbox Management Software "PMSS"
/**
 * Bootstrap a tenant-specific lighttpd instance.
 *
 * Preconditions:
 *   - `/home/<user>/.lighttpd.conf` exists and references per-user sockets.
 *   - lighttpd binary installed at `/usr/sbin/lighttpd`.
 *   - User home writable to create `.lighttpd/` state directories when missing.
 *
 * Postconditions:
 *   - Required subdirectories (`.lighttpd`, `.lighttpd/upload`, optional `.lighttpd/compress`)
 *     exist with user ownership when referenced by config.
 *   - User lighttpd process launched; script prints `ps` output for visibility.
 */

function pmssEnsureUserDir(string $user, string $dir): void
{
    if (is_dir($dir)) {
        return;
    }
    $cmd = sprintf(
        "su %s -c %s",
        escapeshellarg($user),
        escapeshellarg('mkdir -p '.escapeshellarg($dir))
    );
    passthru($cmd);
}

function pmssClearSocketFiles(string $pattern): void
{
    $sockets = glob($pattern);
    if ($sockets === false) {
        return;
    }
    foreach ($sockets as $socket) {
        if (is_file($socket) || is_link($socket)) {
            @unlink($socket);
        }
    }
}

if ($argc != 2) die("Usage: startLighttpd USERNAME\n");
$user = $argv[1];

// Check user is valid
if (!file_exists('/home/' . $user)) die("Invalid username\n");
if (!is_dir('/home/' . $user)) die("User home is not a directory!\n");
if (!file_exists('/home/' . $user . '/.lighttpd.conf')) die("User does not have lighttpd configuration - lighttpd maybe disabled\n");

$lighttpdDir = '/home/'.$user.'/.lighttpd';
$uploadDir   = $lighttpdDir.'/upload';
$configPath  = '/home/'.$user.'/.lighttpd.conf';
$config      = @file_get_contents($configPath);
$deflateEnabled = is_string($config) && preg_match('/^[ \t]*deflate\.cache-dir/m', $config);

pmssEnsureUserDir($user, $lighttpdDir);
pmssEnsureUserDir($user, $uploadDir);
if ($deflateEnabled) {
    pmssEnsureUserDir($user, $lighttpdDir.'/compress');
}
pmssClearSocketFiles($lighttpdDir.'/php.socket*');

passthru("cd /home/{$user}; su {$user} -c '/usr/sbin/lighttpd -f /home/{$user}/.lighttpd.conf'");	// This is for newer versions

passthru("ps aux|grep {$user}"); // Output running processes
