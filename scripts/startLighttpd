#!/usr/bin/env php
<?php
# Pulsed Media Seedbox Management Software "PMSS"
/**
 * Start a per-user lighttpd instance for a tenant.
 *
 * This launcher has its roots in the original per-user web stack introduced
 * around 2010 and is still used by cron watchdogs and user maintenance flows.
 *
 * Preconditions:
 *   - `/home/<user>/.lighttpd.conf` exists and references per-user sockets.
 *   - lighttpd binary installed at `/usr/sbin/lighttpd`.
 *   - User home writable to create `.lighttpd/` state directories when missing.
 *
 * Postconditions:
 *   - Required subdirectories (`.lighttpd`, `.lighttpd/upload`, optional `.lighttpd/compress`)
 *     exist with user ownership when referenced by config.
 *   - User lighttpd process launched; script prints `ps` output for visibility.
 *
 * @author  Aleksi Ursin <aleksi@magnacapax.fi>
 * @copyright 2010-2025 Magna Capax Finland Oy
 */

if ($argc != 2) die("Usage: startLighttpd USERNAME\n");

// Validate username defensively even when invoked from internal scripts,
// same as startRtorrent (ADR 0005) — '../etc' style values would otherwise
// pass the file_exists() checks below and unlink/chdir outside /home.
require_once __DIR__.'/lib/userLifecycle.php';
require_once __DIR__.'/lib/user/serviceLaunch.php';
$user = pmssUsernameNormalizeIfValid((string) $argv[1]);
if ($user === null) die("Invalid username\n");
$homeDir = '/home/'.$user;
$configPath = $homeDir.'/.lighttpd.conf';

/** Return true only when an existing path resolves inside the user's home. */
function pmssStartLighttpdPathWithinHome(string $path, string $homeDir): bool
{
    $homeReal = @realpath($homeDir);
    $pathReal = @realpath($path);
    if ($homeReal === false || $pathReal === false) {
        return false;
    }

    $homeReal = rtrim($homeReal, '/');
    if ($homeReal === '' || $homeReal === '/') {
        return false;
    }

    return $pathReal === $homeReal || strpos($pathReal, $homeReal.'/') === 0;
}

/**
 * Create a managed lighttpd directory and verify it remains under the user home.
 */
function pmssStartLighttpdEnsureDirectory(string $user, string $homeDir, string $dir): bool
{
    if (is_link($dir) || (file_exists($dir) && !is_dir($dir))) {
        return false;
    }

    if (!is_dir($dir)) {
        $rc = 0;
        passthru(pmssBuildUserShellCommand($user, 'mkdir -p '.escapeshellarg($dir)), $rc);
        if ($rc !== 0) {
            return false;
        }
    }

    return is_dir($dir)
        && !is_link($dir)
        && pmssStartLighttpdPathWithinHome($dir, $homeDir);
}

/** Remove one stale socket path only after validating the delete target. */
function pmssStartLighttpdRemoveSocket(string $homeDir, string $socketPath): bool
{
    if (is_link($socketPath) || !pmssStartLighttpdPathWithinHome($socketPath, $homeDir)) {
        return false;
    }

    return @unlink($socketPath) || !file_exists($socketPath);
}

// Check user is valid
if (!file_exists($homeDir)) die("Invalid username\n");
if (!is_dir($homeDir)) die("User home is not a directory!\n");
if (!file_exists($configPath)) die("User does not have lighttpd configuration - lighttpd maybe disabled\n");

$lighttpdDir = $homeDir.'/.lighttpd';
$uploadDir   = $lighttpdDir.'/upload';
$config      = @file_get_contents($configPath);
$deflateEnabled = is_string($config) && preg_match('/^[ \t]*deflate\.cache-dir/m', $config);

$requiredDirs = [$lighttpdDir, $uploadDir];
if ($deflateEnabled) {
    $requiredDirs[] = $lighttpdDir.'/compress';
}
foreach ($requiredDirs as $dir) {
    if (pmssStartLighttpdEnsureDirectory($user, $homeDir, $dir)) {
        continue;
    }
    fwrite(STDERR, "Unable to prepare lighttpd directory: {$dir}\n");
    exit(1);
}
foreach (glob(rtrim($lighttpdDir, '/').'/php.socket*') ?: [] as $socketPath) {
    if (pmssStartLighttpdRemoveSocket($homeDir, $socketPath)) {
        continue;
    }
    fwrite(STDERR, "Unable to remove stale lighttpd socket: {$socketPath}\n");
    exit(1);
}

// lighttpd inherits cwd before opening logs; keep it out of root-only paths.
if (!@chdir($homeDir)) {
    fwrite(STDERR, "Unable to enter user home\n");
    exit(1);
}
$startCommand = 'cd '.escapeshellarg($homeDir).' && /usr/sbin/lighttpd -f '.escapeshellarg($configPath);
$startRc = 0;
passthru(pmssBuildUserServiceShellCommand($user, $startCommand), $startRc);
if ($startRc !== 0) {
    fwrite(STDERR, "Unable to start lighttpd inside user slice\n");
    exit(1);
}

passthru('ps aux | grep '.escapeshellarg($user)); // Output running processes
