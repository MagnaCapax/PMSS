#!/usr/bin/env php
<?php
# Pulsed Media Seedbox Management Software "PMSS"
/**
 * Start a per-user lighttpd instance for a tenant.
 *
 * This launcher has its roots in the original per-user web stack introduced
 * around 2010 and is still used by cron watchdogs and user maintenance flows.
 *
 * Preconditions:
 *   - `/home/<user>/.lighttpd.conf` exists and references per-user sockets.
 *   - lighttpd binary installed at `/usr/sbin/lighttpd`.
 *   - User home writable to create `.lighttpd/` state directories when missing.
 *
 * Postconditions:
 *   - Required subdirectories (`.lighttpd`, `.lighttpd/upload`, optional `.lighttpd/compress`)
 *     exist with user ownership when referenced by config.
 *   - User lighttpd process launched; script prints `ps` output for visibility.
 *
 * @author  Aleksi Ursin <aleksi@magnacapax.fi>
 * @copyright 2010-2025 Magna Capax Finland Oy
 */

if ($argc != 2) die("Usage: startLighttpd USERNAME\n");
$user = $argv[1];
$homeDir = '/home/'.$user;
$configPath = $homeDir.'/.lighttpd.conf';

// Check user is valid
if (!file_exists($homeDir)) die("Invalid username\n");
if (!is_dir($homeDir)) die("User home is not a directory!\n");
if (!file_exists($configPath)) die("User does not have lighttpd configuration - lighttpd maybe disabled\n");

$lighttpdDir = $homeDir.'/.lighttpd';
$uploadDir   = $lighttpdDir.'/upload';
$config      = @file_get_contents($configPath);
$deflateEnabled = is_string($config) && preg_match('/^[ \t]*deflate\.cache-dir/m', $config);

$requiredDirs = [$lighttpdDir, $uploadDir];
if ($deflateEnabled) {
    $requiredDirs[] = $lighttpdDir.'/compress';
}
foreach ($requiredDirs as $dir) {
    if (is_dir($dir)) {
        continue;
    }
    passthru(sprintf(
        "su %s -c %s",
        escapeshellarg($user),
        escapeshellarg('mkdir -p '.escapeshellarg($dir))
    ));
}
foreach (glob(rtrim($lighttpdDir, '/').'/php.socket*') ?: [] as $socketPath) {
    @unlink($socketPath);
}

// lighttpd inherits cwd before opening logs; keep it out of root-only paths.
if (!@chdir($homeDir)) die("Unable to enter user home\n");
$startCommand = '/usr/sbin/lighttpd -f '.escapeshellarg($configPath);
passthru('su '.escapeshellarg($user).' -c '.escapeshellarg($startCommand));

passthru('ps aux | grep '.escapeshellarg($user)); // Output running processes
