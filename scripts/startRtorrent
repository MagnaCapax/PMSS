#!/usr/bin/env php
<?php
/**
 * Start a per-user rTorrent instance inside a detached screen session.
 *
 * This launcher has been in production since around 2010 and is relied on by
 * multiple automation entry points (e.g. unsuspend flows and instance checks).
 *
 * @author  Aleksi Ursin <aleksi@magnacapax.fi>
 * @copyright 2010-2025 Magna Capax Finland Oy
 */
require_once __DIR__.'/lib/logger.php';
require_once __DIR__.'/lib/runtime.php';
$userLogLib = __DIR__.'/lib/user/log.php';
if (is_file($userLogLib)) {
    require_once $userLogLib;
}
require_once __DIR__.'/lib/rtorrent/process.php';

if ($argc !== 2) {
    logmsg('Usage: startRtorrent USERNAME');
    exit(1);
}

// Validate username defensively even when invoked from internal scripts.
// Treat any internal tool output as untrusted (ADR 0005).
$userLifecycleLib = __DIR__.'/lib/userLifecycle.php';
if (is_file($userLifecycleLib)) {
    require_once $userLifecycleLib;
}

$user = function_exists('pmssUsernameNormalizeIfValid')
    ? pmssUsernameNormalizeIfValid((string) $argv[1])
    : null;
if ($user === null) {
    $user = strtolower(trim((string) $argv[1]));
    logmsg("Invalid username: {$user}");
    exit(1);
}

$home = '/home/'.$user;

/**
 * Start rTorrent for the user (legacy direct start or executor wrapper).
 */
function pmssStartRtorrentLaunch(string $user, string $home, string $executor): void
{
    if (!file_exists($executor)) {
        // If old version of master GUI, call rTorrent directly.
        logmsg("Starting rTorrent for {$user} (legacy mode)");
        $sessionPrefix = $home.'/session/rtorrent.';
        $candidates = glob($sessionPrefix.'*');
        if (is_array($candidates)) {
            foreach ($candidates as $path) {
                if (strpos($path, $sessionPrefix) !== 0) {
                    continue;
                }
                if (is_file($path) || is_link($path)) {
                    @unlink($path);
                }
            }
        }
        $cmd = 'su - '.escapeshellarg($user).' -c '.escapeshellarg('screen -S rtorrent -fa -d -m rtorrent');
        passthru($cmd);
        return;
    }

    // Newer versions use .rtorrentExecute.php wrapper.
    logmsg("Starting rTorrent for {$user} via .rtorrentExecute.php");
    $cmd = 'su - '.escapeshellarg($user).' -c '.escapeshellarg('screen -S rtorrent -fa -d -m ./.rtorrentExecute.php');
    passthru($cmd);
}

/**
 * Wait for rTorrent to appear, then verify the same process survives.
 *
 * The executor intentionally sleeps 2-8 seconds before starting rtorrent. A
 * later crash must not count as a healthy launch, so success requires both
 * initial appearance and a second survival check for the same PID.
 */
function pmssStartRtorrentWaitForRtorrent(string $user, int $startupTimeoutSeconds, int $stabilityWindowSeconds): bool
{
    return rtorrentProcessWaitForStablePids(
        function () use ($user): array {
            return rtorrentProcessPgrepExact($user, 'rtorrent');
        },
        (float) max(1, $startupTimeoutSeconds),
        (float) max(1, $stabilityWindowSeconds)
    );
}

// Basic sanity checks so operators get immediate feedback instead of silent exits.
if (!is_dir($home)) {
    logmsg("User home is not a directory: {$home}");
    exit(1);
}

$userConfig = $home.'/.rtorrent.rc';
if (!file_exists($userConfig)) {
    logmsg('User does not have rtorrent configuration - rTorrent maybe disabled');
    exit(1);
}

$lockPath = pmssRuntimeLockPath('pmss-startRtorrent-'.$user.'.lock');
$lockBusy = false;
$lockHandle = pmssLockFileAcquire($lockPath, true, 'c', false, true, $lockBusy);
if ($lockHandle === false) {
    logmsg("[WARN] Failed to open lock file {$lockPath}; refusing to start rTorrent");
    exit(1);
}
if ($lockBusy) {
    logmsg("[INFO] Another startRtorrent is already running for {$user}; skipping");
    exit(0);
}
// If the executor script exists but is missing the lock guard, refresh it from
// /etc/skel so watchdog-driven starts do not spawn duplicate rTorrent processes.
$executor = $home.'/.rtorrentExecute.php';
$skelExecutor = '/etc/skel/.rtorrentExecute.php';
if (is_file($executor) && is_file($skelExecutor) && !is_link($executor)) {
    $executorData = @file_get_contents($executor);
    $executorHasLock = is_string($executorData) && $executorData !== '' && strpos($executorData, '.rtorrentExecute.lock') !== false && strpos($executorData, 'flock(') !== false;

    $skelData = @file_get_contents($skelExecutor);
    $skelHasLock = is_string($skelData) && $skelData !== '' && strpos($skelData, '.rtorrentExecute.lock') !== false && strpos($skelData, 'flock(') !== false;
    if (!$executorHasLock && $skelHasLock) {
        if (@copy($skelExecutor, $executor)) {
            @chmod($executor, 0755);
            @chown($executor, $user);
            if (function_exists('posix_getpwnam')) {
                $pw = @posix_getpwnam($user);
                if (is_array($pw) && isset($pw['gid'])) {
                    @chgrp($executor, (int) $pw['gid']);
                }
            }
            logmsg("[INFO] Refreshed {$executor} from {$skelExecutor} (added lock guard)");
        } else {
            logmsg("[WARN] Failed to refresh {$executor} from {$skelExecutor}");
        }
    }
}

$rtorrentRc = 0;
$rtorrentOut = [];
$rtorrentPids = rtorrentProcessPgrepExact($user, 'rtorrent', $rtorrentRc, $rtorrentOut);
if (!empty($rtorrentPids)) {
    logmsg("rTorrent already running for {$user}; skipping start");
    exit(0);
}
if ($rtorrentRc !== 0 && $rtorrentRc !== 1) {
    logmsg("[WARN] Failed to check rTorrent process state for {$user} (rc={$rtorrentRc}): ".implode(' | ', $rtorrentOut));
    exit(1);
}

$executorRc = 0;
$executorOut = [];
$executorPids = rtorrentProcessExecutorPids($user, $executorRc, $executorOut)['all'];
if (!empty($executorPids)) {
    logmsg("Executor already running for {$user} but rtorrent missing; refusing to start another executor");
    exit(0);
}
if ($executorRc !== 0 && $executorRc !== 1) {
    logmsg("[WARN] Failed to check executor process state for {$user} (rc={$executorRc}): ".implode(' | ', $executorOut));
    exit(1);
}

// Check that the optional localnet filter file is readable for the user.
// When it exists but is not readable rTorrent will exit with:
//   "Could not open ip filter file: /etc/seedbox/config/localnet"
$localnet = '/etc/seedbox/config/localnet';
if (file_exists($localnet)) {
    $checkCmd = 'su - '.escapeshellarg($user).' -c '.escapeshellarg('test -r '.$localnet);
    $output = [];
    $rc = 0;
    exec($checkCmd, $output, $rc);
    if ($rc !== 0) {
        logmsg("[WARN] {$localnet} exists but is not readable by {$user}; rTorrent will likely fail with a localnet ip filter error.");
        logmsg("[HINT] Run '/scripts/util/setupPermissions.php' as root or check: ls -ld /etc/seedbox /etc/seedbox/config {$localnet}");
    }
}

// Check if session directory exists - if not create it.
if (!is_dir($home.'/session')) {
    logmsg("Creating rTorrent session directory for {$user}");
    @mkdir($home.'/session', 0755, true);
    @chown($home.'/session', $user);
    if (function_exists('posix_getpwnam')) {
        $pw = @posix_getpwnam($user);
        if (is_array($pw) && isset($pw['gid'])) {
            @chgrp($home.'/session', (int) $pw['gid']);
        }
    }
}

// Finally execute rTorrent inside a screen session.
pmssStartRtorrentLaunch($user, $home, $executor);

// Output a small process snapshot so operators can see whether rTorrent or the
// wrapper stayed up, without relying on grep parsing.
$psLines = [];
$psRc = 0;
@exec('ps -u '.escapeshellarg($user).' -o pid=,ppid=,stat=,lstart=,comm=,args=', $psLines, $psRc);
if ($psRc === 0 && !empty($psLines)) {
    logmsg('Process snapshot (rtorrent/screen/php wrapper):');
    foreach ($psLines as $line) {
        $haystack = strtolower($line);
        if (strpos($haystack, 'rtorrent') === false
            && strpos($haystack, 'rtorrentexecute') === false
            && strpos($haystack, 'screen') === false) {
            continue;
        }
        logmsg(trim($line));
    }
}

// If rTorrent did not stay up, a broken ~/.rtorrent.rc.custom can be the cause.
// Wait for the executor delay, then require the same rtorrent PID to survive a
// second health check before clearing the consecutive-failure counter.
$startupWaitSeconds = 30;
$startupStabilitySeconds = 30;
$customConfigFailureLimit = 4;
$stateDir = '/run/pmss';
$legacyStateFile = $stateDir.'/startRtorrent-customrc-fail-'.$user.'.ts';
$failureStateFile = $stateDir.'/startRtorrent-customrc-fail-'.$user.'.count';

logmsg(
    "[INFO] Waiting up to {$startupWaitSeconds}s for rTorrent to appear for {$user} and {$startupStabilitySeconds}s more to confirm survival"
);
if (pmssStartRtorrentWaitForRtorrent($user, $startupWaitSeconds, $startupStabilitySeconds)) {
    rtorrentProcessClearStaleState($legacyStateFile);
    rtorrentProcessClearStaleState($failureStateFile);
    exit(0);
}

if (!is_dir($stateDir)) {
    @mkdir($stateDir, 0755, true);
}

// Drop legacy timer state so old false positives do not survive the new logic.
rtorrentProcessClearStaleState($legacyStateFile);
$state = rtorrentProcessCheckFailureCountState($failureStateFile, $customConfigFailureLimit);

if ($state['action'] !== 'stale') {
    logmsg(
        "[WARN] rTorrent not running after start for {$user}; failed launch attempt "
        .$state['count'].'/'.$customConfigFailureLimit
        .' before quarantining .rtorrent.rc.custom (launch or survival check failed)'
    );
    exit(0);
}

logmsg(
    "[WARN] rTorrent repeatedly failed to start for {$user} (attempt "
    .$state['count'].'/'.$customConfigFailureLimit
    .'); quarantining .rtorrent.rc.custom'
);
if (function_exists('pmssUserLog')) {
    pmssUserLog($user, 'startRtorrent: repeated failures; quarantining .rtorrent.rc.custom');
}

$logFn = function (string $message, bool $force = true): void {
    logmsg($message);
};
$quarantined = rtorrentCustomConfigQuarantine($home, $user, $logFn);
rtorrentProcessClearStaleState($failureStateFile);
if ($quarantined === null) {
    exit(0);
}
if (function_exists('pmssUserLog')) {
    pmssUserLog($user, 'startRtorrent: quarantined .rtorrent.rc.custom -> '.basename($quarantined));
}

// Clear any stuck wrapper/screen processes before retrying the start.
$executorPids = rtorrentProcessExecutorPids($user)['all'];
if (!empty($executorPids)) {
    rtorrentProcessKillPids($executorPids, SIGKILL);
    usleep(250000);
}

pmssStartRtorrentLaunch($user, $home, $executor);
logmsg(
    "[INFO] Re-checking rTorrent stability for {$user} after quarantining custom config"
);
if (pmssStartRtorrentWaitForRtorrent($user, $startupWaitSeconds, $startupStabilitySeconds)) {
    logmsg("[OK] rTorrent started for {$user} after quarantining custom config");
    if (function_exists('pmssUserLog')) {
        pmssUserLog($user, 'startRtorrent: started after quarantining .rtorrent.rc.custom');
    }
} else {
    logmsg("[WARN] rTorrent still not running for {$user} after quarantining custom config");
}
