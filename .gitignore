# Ignore everything
*

# But not these directories and their contents

## start of etc
!/etc

# /etc/seedbox
!/etc/seedbox/
!/etc/seedbox/config/
!/etc/seedbox/config/*
/etc/seedbox/config/app-versions/
/etc/seedbox/config/default
/etc/seedbox/config/fireqos.conf
/etc/seedbox/config/network
/etc/seedbox/config/version

!/etc/seedbox/runtime/
/etc/seedbox/runtime/version

!/etc/seedbox/skel
!/etc/seedbox/skel/srvmgmt
!/etc/seedbox/skel/srvmgmt/*
#

# /etc/skel
!/etc/skel/
!/etc/skel/*
!/etc/skel/bin/
!/etc/skel/bin/**
!/etc/skel/www/*
!/etc/skel/www/*/**
/etc/skel/www/openvpn-config.tgz
/etc/skel/.config/
/etc/skel/.tmp/
#
## end of etc

## start of scripts
!/scripts/
!/scripts/*
!/scripts/**

## end of scripts

# start of var
!/var/
!/var/www/
!/var/www/*.php
!/var/www/*.html
!/var/www/502_images
!/var/www/502_images/*
!/var/www/404_images
!/var/www/404_images/*
!/var/www/css/
!/var/www/css/*

## end of var

# Documentation
!/docs/
!/docs/**
!/tests/
!/tests/**
!/.github/
!/.github/**
!/CONTRIBUTING.md
!/development/
!/development/**
# development/prompts/ tracked in git (agent instructions for dev cycle)

# Additionally, do not ignore .gitignore file itself
!.gitignore

# And do not ignore gitkeep files to keep empty directories
!.gitkeep

!/AGENTS.*.md
AGENTS.*.local.md
AGENTS.local.md
!GEMINI.md
!/soul.md

# Explicitly ignore local assistant config/state and CI scratch
.codex
.codex-prompt
.geminiignore
# Note: ci-codex and job artifacts are written to the system temp dir
.DS_Store

# Tool artifacts
tools/
