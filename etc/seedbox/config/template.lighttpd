server.modules              = (
        # order (may) matter; do not alphabetize
        "mod_access",
        "mod_auth",
        "mod_authn_file",
        "mod_alias",
        "mod_setenv",
        "mod_webdav",
        "mod_fastcgi",
        "mod_proxy",
        # mod_deflate disabled (2025-11): single-tenant vhosts gain negligible benefit; revisit post-2028 and remove packages/config if still unused.
        #"mod_deflate",
        "mod_accesslog",
)
#See https://redmine.lighttpd.net/projects/lighttpd/wiki/Docs_ConfigurationOptions
server.port = ##serverPort
server.document-root       = "/home/##username/www/public/"
server.upload-dirs = ( "/home/##username/.lighttpd/upload" )
server.errorlog            = "/home/##username/.lighttpd/error.log"
accesslog.filename         = "/home/##username/.lighttpd/access.log"
server.pid-file            = "/home/##username/.lighttpd/lighttpd.pid"
connection.kbytes-per-second    = 204800
server.kbytes-per-second        = 409600
# Lighttpd essentially has caching / buffering enabled by default! This disables
server.stream-response-body = 2
server.stream-request-body = 2
index-file.names           = ( "index.php", "index.html",
                               "index.lighttpd.html" )



url.access-deny            = ( "~", ".inc" )
static-file.exclude-extensions = ( ".php", ".pl", ".fcgi" )


dir-listing.encoding        = "utf-8"
dir-listing.activate        = "enable"

## change uid to <uid> (default: don't care)
server.username            = "##username"

## change uid to <uid> (default: don't care)
server.groupname           = "##username"

#### compress module
# deflate disabled: marginal value for per-user vhosts; keep commented until post-2028 refactor removes module/package entirely.
#deflate.mimetypes          = ("text/html", "text/css", "application/javascript")



#### external configuration files
## mimetype mapping
include_shell "/usr/share/lighttpd/create-mime*pl"

include "/home/##username/.lighttpd/custom"
include "/home/##username/.lighttpd/custom.d/*.conf"

auth.backend = "htpasswd"
auth.backend.htpasswd.userfile = "/home/##username/.lighttpd/.htpasswd"

auth.require = (
 "/user-##username/" =>
    (
        "method" => "basic",
        "realm" => "Password protected area",
        "require" => "user=##username"
    ) 
 "/webdav-##username/" =>
    (
        "method" => "basic",
        "realm" => "Password protected area",
        "require" => "user=##username"
    )
)


alias.url += (
 "/user-##username/" => "/home/##username/www/",
 "/webdav-##username/" => "/home/##username/",
 "/public-##username/" => "/home/##username/www/public/",
 "/public/" => "/home/##username/www/public/"
)

# PMSS_WEBDAV_BEGIN
$HTTP["url"] =~ "^/webdav-##username($|/)" {
    webdav.activate = "enable"
    webdav.sqlite-db-name = "/home/##username/.lighttpd/webdav.lock.db"
    dir-listing.activate = "disable"

    # Defense-in-depth: do not expose dotfiles via WebDAV (prevents users from
    # breaking runtimes by editing internal config/state).
    url.access-deny = ( "/." )
}

# Allow read access, but make www read-only to prevent common footguns.
##PMSS_WEBDAV_WWW_POLICY##
# PMSS_WEBDAV_END

$HTTP["url"] =~ "^/user-##username/rclone/" {
  proxy.server = ( "" => ( (
    "host" => "127.0.0.1",
    "port" => ##rclonePort
  ) ) )
}


$HTTP["url"] =~ "^/user-##username/qbittorrent/" {
  proxy.server = ( "" => ( (
    "host" => "127.0.0.1",
    "port" => ##qbittorrentPort
  ) ) ),
  proxy.forwarded = ( "for" => 1,
                      "host" => 1,
                      "by" => 1
  ),
  proxy.header = (
      "map-urlpath" => (
         "/user-##username/qbittorrent/"  => "/",
         "/user-##username/qbittorrent" => ""
       )
  )
}



$HTTP["url"] =~ "^/owncloud/data/" {
        url.access-deny = ("")
}

$HTTP["url"] =~ "^/user-##username/rutorrent/" {
    setenv.add-response-header += (
        "Cache-Control" => "private, no-cache, must-revalidate, no-store",
        "Pragma" => "no-cache",
        "Expires" => "0"
    )
}

$HTTP["url"] =~ "^/owncloud($|/)" {
        dir-listing.activate = "disable"
}

fastcgi.debug = 0


fastcgi.server += ( ".php" =>
        ((
                "bin-path"              => "/usr/bin/php-cgi ",
                "bin-args"              => ( "-c", "/home/##username/.lighttpd/php.ini" ),
                "socket"                => "/home/##username/.lighttpd/php.socket",
                "max-procs"             => 6,
                "min-procs"             => 1,
                "bin-environment" => (
                    "PHP_FCGI_CHILDREN" => "6",
                    "PHP_FCGI_MAX_REQUESTS" => "5000"
                ),
                "bin-copy-environment" => (
                        "PATH", "SHELL", "USER"
                ),
                "broken-scriptfilename" => "enable"
        ))
)
