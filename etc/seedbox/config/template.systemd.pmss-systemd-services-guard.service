[Unit]
Description=PMSS boot-time system service hardening guard
Documentation=https://github.com/MagnaCapax/PMSS
DefaultDependencies=no
After=local-fs.target
Before=basic.target
Before=apache2.service
Before=lighttpd.service
Before=deluged.service
Before=deluge-web.service
Before=qbittorrent-nox.service
Before=transmission-daemon.service
Before=redis-server.service
Before=memcached.service
Before=rpcbind.service
Before=rpcbind.socket
Before=nfs-kernel-server.service
Before=nfs-server.service
Before=nfs-idmapd.service
Before=rpc-statd.service
Before=smbd.service
Before=nmbd.service
Before=samba.service
Before=avahi-daemon.service
Before=avahi-daemon.socket
Before=cups.service
Before=cups.socket
Before=cups.path
Before=cups-browsed.service
Before=exim4.service
Before=docker.service
Before=docker.socket
Before=containerd.service
ConditionPathExists=/scripts/cron/systemdServicesGuard.php

[Service]
Type=oneshot
ExecStart=/usr/bin/php /scripts/cron/systemdServicesGuard.php
TimeoutStartSec=45

[Install]
WantedBy=basic.target
