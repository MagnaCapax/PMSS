/var/log/pmss-update.log /var/log/pmss-update.jsonl /var/log/pmss-update.profile.json /var/log/pmss/update.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/userDbCleanup.log {
    daily
    rotate 7
    minsize 1M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/users.log /var/log/pmss/users.jsonl /var/log/pmss/trafficStats.log /var/log/pmss/user-home-reclaim.log {
    daily
    rotate 7
    size 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
    sharedscripts
}

# Performance-metric logs: keep ALL history, effectively forever, uncompressed.
# rotate 9999 = logrotate has no "infinite" keyword; a huge finite count never
# deletes within any realistic node lifetime (operator directive 2026-08-14:
# "keep them all on server side", ADR 0044). maxsize is a file-SPLITTER only
# (forces rotation into a new file) — it never deletes data.
/var/log/pmss/system-stats.log {
    yearly
    rotate 9999
    maxsize 1G
    missingok
    notifempty
    nocompress
    copytruncate
    sharedscripts
}

/var/log/pmss/iostat-history.log {
    yearly
    rotate 9999
    maxsize 1G
    missingok
    notifempty
    nocompress
    create 0644 root root
}

/var/log/pmss/iostat-history-raw.log {
    yearly
    rotate 9999
    maxsize 1G
    missingok
    notifempty
    nocompress
    create 0644 root root
}

/var/log/pmss/check*.log {
    monthly
    rotate 7
    minsize 1M
    maxsize 64M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

# Performance/storage-metric logs: keep ALL history forever, uncompressed
# (operator directive 2026-08-14, ADR 0044). rotate 9999 = effectively unlimited;
# maxsize (where present) is a non-deleting file-splitter only.
/var/log/pmss/quota-daily.log {
    monthly
    rotate 9999
    missingok
    notifempty
    nocompress
    create 0600 root root
}

/var/log/pmss/resource-daily.log {
    monthly
    rotate 9999
    missingok
    notifempty
    nocompress
    create 0600 root root
}

/var/log/pmss/metrics/* {
    daily
    rotate 9999
    missingok
    notifempty
    nocompress
    nocreate
    maxsize 50M
}

/var/log/pmss/process-snapshot.log {
    weekly
    rotate 9999
    minsize 1M
    maxsize 128M
    missingok
    notifempty
    nocompress
    copytruncate
    create 0600 root root
}

/var/log/pmss/storage-health.jsonl /var/log/pmss/storageHealthSnapshot.log {
    daily
    rotate 9999
    missingok
    notifempty
    nocompress
    create 0600 root root
}

/var/log/pmss/user/*.log /var/log/pmss/users/*.log {
    daily
    rotate 7
    minsize 1M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}
