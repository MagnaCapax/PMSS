/var/log/pmss-update.log /var/log/pmss-update.jsonl /var/log/pmss-update.profile.json /var/log/pmss/update.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/userDbCleanup.log {
    daily
    rotate 7
    minsize 1M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/users.log /var/log/pmss/users.jsonl /var/log/pmss/trafficStats.log /var/log/pmss/user-home-reclaim.log {
    daily
    rotate 7
    size 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
    sharedscripts
}

/var/log/pmss/system-stats.log {
    yearly
    rotate 100
    maxsize 1G
    missingok
    notifempty
    nocompress
    copytruncate
    sharedscripts
}

/var/log/pmss/iostat-history.log {
    yearly
    rotate 100
    maxsize 1G
    missingok
    notifempty
    nocompress
    create 0644 root root
}

/var/log/pmss/iostat-history-raw.log {
    yearly
    rotate 10
    maxsize 512M
    missingok
    notifempty
    nocompress
    create 0644 root root
}

/var/log/pmss/check*.log {
    monthly
    rotate 7
    minsize 1M
    maxsize 64M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/quota-daily.log {
    monthly
    rotate 24
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
}

/var/log/pmss/resource-daily.log {
    monthly
    rotate 24
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
}

/var/log/pmss/metrics/* {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    nocreate
    maxsize 50M
}

/var/log/pmss/process-snapshot.log {
    weekly
    rotate 8
    minsize 1M
    maxsize 128M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0600 root root
}

/var/log/pmss/storage-health.jsonl /var/log/pmss/storageHealthSnapshot.log {
    daily
    rotate 30
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
}

/var/log/pmss/user/*.log /var/log/pmss/users/*.log {
    daily
    rotate 7
    minsize 1M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}
