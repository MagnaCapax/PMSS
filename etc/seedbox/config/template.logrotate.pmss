/var/log/pmss-update.log /var/log/pmss-update.jsonl /var/log/pmss-update.profile.json /var/log/pmss/update.log {
    daily
    rotate 7
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/userDbCleanup.log {
    daily
    rotate 7
    minsize 1M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/users.log /var/log/pmss/users.jsonl /var/log/pmss/trafficStats.log /var/log/pmss/user-home-reclaim.log {
    daily
    rotate 7
    size 100M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su root root
    sharedscripts
}

# Performance-metric logs: keep long history, compress old generations, and
# delete the oldest rotations before /var/log can fill root (ADR 0044 amendment
# 2026-09-05). delaycompress keeps the newest rotation directly greppable.
/var/log/pmss/system-stats.log {
    yearly
    rotate 10
    maxsize 1G
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/iostat-history.log {
    yearly
    rotate 10
    maxsize 1G
    missingok
    notifempty
    compress
    delaycompress
    create 0644 root root
}

/var/log/pmss/iostat-history-raw.log {
    yearly
    rotate 10
    maxsize 1G
    missingok
    notifempty
    compress
    delaycompress
    create 0644 root root
}

# Service-watchdog / health-check history is observability; keep ten years of
# monthly rotations, gzip older generations, and retain maxsize as a splitter.
/var/log/pmss/check*.log {
    monthly
    rotate 120
    minsize 1M
    maxsize 64M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

# Performance/storage-metric logs use ten-year-equivalent retention by cadence.
# Rotated per-user metric files leave the live metrics directory so the wildcard
# cannot recursively rotate its own output.
/var/log/pmss/quota-daily.log /var/log/pmss/quotaSnapshot.log {
    monthly
    rotate 120
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
}

/var/log/pmss/resource-daily.log {
    monthly
    rotate 120
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
}

/var/log/pmss/metrics/* {
    daily
    rotate 3650
    missingok
    notifempty
    compress
    delaycompress
    nocreate
    olddir /var/log/pmss/metrics/archive
    createolddir 0755 root root
    maxsize 50M
}

/var/log/pmss/process-snapshot.log {
    weekly
    rotate 520
    minsize 1M
    maxsize 128M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0600 root root
}

/var/log/pmss/storage-health.jsonl /var/log/pmss/storageHealthSnapshot.log {
    daily
    rotate 3650
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
}

/var/log/pmss/user/*.log /var/log/pmss/users/*.log {
    daily
    rotate 7
    minsize 1M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}

/var/log/pmss/arpKeepalive.log {
    weekly
    rotate 52
    minsize 1M
    maxsize 16M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    create 0600 root root
}

# Cron job output that root.cron appends here (">> ... 2>&1"). Without a stanza these grew
# forever on every host. Same retention as the check*.log watchdog history above.
/var/log/pmss/backupEtc.log
/var/log/pmss/certbotRenewalCheck.log
/var/log/pmss/cgroupBfqWeightApply.log
/var/log/pmss/cgroupIopsLimitApply.log
/var/log/pmss/cgroupPolicyRefresh.log
/var/log/pmss/cgroupRootCheck.log
/var/log/pmss/cpuStat.log
/var/log/pmss/iopsLimits.log
/var/log/pmss/iostatLog.log
/var/log/pmss/lighttpdAccessLogTrim.log
/var/log/pmss/liveStatsLog.log
/var/log/pmss/mdadmCheckarray.log
/var/log/pmss/mediaStackInstancesCheck.log
/var/log/pmss/metricsLog.log
/var/log/pmss/motdGenerate.log
/var/log/pmss/resourceLog.log
/var/log/pmss/resourceStats.log
/var/log/pmss/rootlessDocker.log
/var/log/pmss/rtorrentPortReservationsReconcile.log
/var/log/pmss/scheduledConfigBackup.log
/var/log/pmss/setupNetwork.log
/var/log/pmss/systemStatsLog.log
/var/log/pmss/systemdControlChannelCheck.log
/var/log/pmss/systemdServicesGuard.log
/var/log/pmss/trafficIngressLog.log
/var/log/pmss/trafficIngressStats.log
/var/log/pmss/trafficLimits.log
/var/log/pmss/trafficLog.log
/var/log/pmss/transmissionInstancesCheck.log
/var/log/pmss/updateQuotas.log
/var/log/pmss/usageAlerts.log
/var/log/pmss/userTrackerCleaner.log
/var/log/pmss/webPublicCertsProcess.log
/var/log/pmss/wireguardPeersRefresh.log {
    monthly
    rotate 120
    minsize 1M
    maxsize 64M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    sharedscripts
}
