# Default proxy parameters for nginx reverse proxy locations.
#
# Nginx is a lightweight reverse proxy in PMSS; per-user lighttpd handles the
# heavy lifting for WebDAV and application traffic. Keep proxy headers and
# timeouts centralized here to avoid per-location drift and duplication.

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Authorization $http_authorization;
proxy_read_timeout 300s;
proxy_send_timeout 300s;
client_body_timeout 300s;
send_timeout 300s;
proxy_buffering off;

# Generic proxy locations keep nginx request buffering defaults. WebDAV uses
# /etc/nginx/webdav_proxy_params so multi-GB uploads stream to lighttpd.

