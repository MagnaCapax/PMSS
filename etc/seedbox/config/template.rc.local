#!/bin/bash

modprobe bfq;

for DISK in `ls /sys/block|grep -v nvme|grep -v md|grep -v loop`
do
    echo 4096 > /sys/block/${DISK}/queue/read_ahead_kb  &
    echo "bfq" > /sys/block/${DISK}/queue/scheduler  &

done

for MD in `ls /sys/block|grep md|grep -v nvme|grep -v loop|grep -v bcache`
do
    # If RAID5, set stripe cache size
    echo 32768 | tee /sys/block/${MD}/md/stripe_cache_size >> /dev/null 2>&1
    # Sync speed: We do not want absolutely max speed, we need to ensure system remains usable during resync period
    echo 10000 | tee /sys/block/${MD}/md/sync_speed_min >> /dev/null 2>&1
    echo 75000 | tee /sys/block/${MD}/md/sync_speed_max >> /dev/null 2>&1
    echo 4096 > /sys/block/${MD}/queue/read_ahead_kb >> /dev/null 2>&1
    echo "bfq" > /sys/block/${MD}/queue/scheduler  &
done

# If there is bcache, set writeback caching
for BCACHE in `ls /sys/block|grep -v md|grep -v nvme|grep -v loop|grep bcache`
do
    echo writeback > /sys/block/${BCACHE}/bcache/cache_mode
    echo 75 > /sys/block/${BCACHE}/bcache/writeback_percent
    echo 300 > /sys/block/${BCACHE}/bcache/writeback_delay
done

# Some security enhancements, making double certain
mount -o remount,hidepid=2 /proc;
chmod 741 /home;
chmod 740 /home/* /var/run/utmp /var/log/wtmp;
# NOTE(safety): listUsers.php output is NOT implicitly trusted (mid-update failures can emit garbage).
# userPermissions.php MUST validate usernames before touching /home paths (see ADR 0004/0005).
nohup /scripts/listUsers.php | xargs -n1 /scripts/util/userPermissions.php >> /dev/null 2>&1 &

# Ensure per-user systemd instances are started so user services (e.g., rootless Docker) can run
nohup /scripts/listUsers.php | while read -r U; do
    [ -z "$U" ] && continue
    UID_NUM=$(id -u "$U" 2>/dev/null) || continue
    systemctl start "user@${UID_NUM}.service" || true
    if command -v php >/dev/null 2>&1 && [ -f /scripts/lib/user/log.php ]; then
        php -r 'require "/scripts/lib/user/log.php"; if (function_exists("pmssUserLog") && isset($argv[1])) { pmssUserLog($argv[1], "rc.local: ensured user@ service running"); }' "$U" >/dev/null 2>&1 || true
    fi
done >> /dev/null 2>&1 &

# If /home is in fstab but not mounted yet, retry once after boot settles.
if ! grep -qE '[[:space:]]/home[[:space:]]' /proc/mounts; then
    if grep -qE '^[^#].*[[:space:]]/home[[:space:]]' /etc/fstab; then
        nohup bash -c 'sleep 30; grep -qE "[[:space:]]/home[[:space:]]" /proc/mounts || mount /home' >> /dev/null 2>&1 &
    fi
fi

# If an update run removed `/etc/cron.d/pmss` mid-flight, restore the template
# without restarting cron (restarting cron can re-trigger @reboot jobs).
if [ -f /etc/seedbox/config/root.cron ]; then
    install -m 0644 /etc/seedbox/config/root.cron /etc/cron.d/pmss >/dev/null 2>&1 || true
fi

# Refresh MOTD at boot so service/network status reflects current runtime state.
if command -v php >/dev/null 2>&1 && [ -x /scripts/util/motdGenerate.php ]; then
    mkdir -p /var/log/pmss >/dev/null 2>&1 || true
    /scripts/util/motdGenerate.php >> /var/log/pmss/motdGenerate.log 2>&1 || true
fi

exit 0
