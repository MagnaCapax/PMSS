# PMSS customer stable host for ##username##.
# Document root: /home/##username##/www/##docrootSubdir##/
server {
        listen 80;
        server_name ##serverNames##;

        location / {
                proxy_pass http://127.0.0.1:##serverPort####lighttpdAlias##;
                proxy_set_header Upgrade $http_upgrade;
                proxy_set_header Connection "upgrade";
                include /etc/nginx/proxy_params;
                proxy_http_version 1.1;
                limit_rate_after 100m;
                limit_rate 32768k;
                limit_conn addr 8;
                error_page 502 /error-502-##username##.html;
        }

        location = /error-502-##username##.html {
                root /var/www;
                internal;
                try_files $uri /error-502.html;
        }
}
