# Private area: keep /user-##username/ locked behind auth and do not
# expose it via public subdomain routing.
location = /user-##username/hermes {
        return 308 /user-##username/hermes/;
}
location ^~ /user-##username/hermes/ {
        # lighttpd keeps panel authentication, then clears Authorization before the account relay.
        proxy_pass http://127.0.0.1:##serverPort/user-##username/hermes/;
##PMSS_HERMES_RELAY_HEADERS##
        # Panel auth must reach lighttpd; client forwarding metadata must not reach Hermes.
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        limit_conn addr 32;
        proxy_hide_header Service-Worker-Allowed;
        # mod_proxy reverses its / mapping even on already-prefixed upstream redirects and cookies.
        proxy_redirect ~^(?:https?://[^/]+)?(/user-##username/hermes)/user-##username/hermes(.*)$ $1$2;
        proxy_cookie_path ~^/user-##username/hermes/user-##username/hermes(.*)$ /user-##username/hermes$1;
        # Keep query strings and launcher tokens out of the dashboard access log.
        access_log off;
        if ($scheme != https) { return 403; }
        set $pmss_hermes_request "$request_method:$http_upgrade:$http_origin";
        set $pmss_hermes_origin_required 1;
        if ($pmss_hermes_request = "GET::") { set $pmss_hermes_origin_required 0; }
        if ($http_origin = "https://$host") { set $pmss_hermes_origin_required 0; }
        if ($pmss_hermes_origin_required = 1) { return 403; }
        set $pmss_hermes_api "$request_method:$uri:$http_sec_fetch_site";
        # Fetch Metadata: refuse only what the browser marks cross-site or same-site; an absent header
        # (Chromium WebSocket handshakes, older browsers) passes, and upgrades already need the exact Origin.
        if ($pmss_hermes_api ~ "(?s)^GET:/user-##username/hermes/api/.*:(cross-site|same-site)$") { return 403; }
        if ($uri = /user-##username/hermes/api/cron/fire) { return 404; }
}

location /user-##username/ {
        proxy_pass http://127.0.0.1:##serverPort/user-##username/;
        # A page here may not widen a service worker's scope over other paths on this host.
        proxy_hide_header Service-Worker-Allowed;
        # Deluge map-urlpath can double cookie paths; normalize to canonical base.
        proxy_cookie_path ~^/user-##username/deluge/user-##username/deluge/.* /user-##username/deluge/;
        proxy_set_header Upgrade $http_upgrade;
#        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        limit_rate_after 1024m;
        limit_rate 102400k;
        limit_conn addr 16;
        error_page 502 /error-502-##username.html;
}

# Internal account UI mounts must not be reachable on the shared panel origin.
location ^~ /public-##username/__pmss-ui- { return 404; }
location ^~ /~##username/__pmss-ui- { return 404; }

location /public-##username/ {
        # A tenant's challenge must never replace the shared panel's cached Basic realm.
        proxy_hide_header WWW-Authenticate;
        proxy_pass http://127.0.0.1:##serverPort/;
        # A page here may not widen a service worker's scope over other paths on this host.
        proxy_hide_header Service-Worker-Allowed;
        # lighttpd map-urlpath restores Location headers, but it does not
        # rewrite Set-Cookie Path values for proxied responses. Keep login
        # cookies scoped to the external /public-##username/<app> paths here.
        proxy_cookie_path /sabnzbd /public-##username/sabnzbd;
        proxy_cookie_path /lidarr /public-##username/lidarr;
        proxy_cookie_path /radarr /public-##username/radarr;
        proxy_cookie_path /prowlarr /public-##username/prowlarr;
        proxy_cookie_path /readarr /public-##username/readarr;
        proxy_cookie_path /sonarr /public-##username/sonarr;
        proxy_cookie_path /jellyfin /public-##username/jellyfin;
        proxy_cookie_path /komga /public-##username/komga;
        proxy_cookie_path /autobrr /public-##username/autobrr;
        proxy_cookie_path /whisparr /public-##username/whisparr;
        # Keep redirect rewriting generic so nginx does not need per-app
        # location rules for trailing-slash and similar lighttpd responses.
        proxy_redirect ~^(https?://[^/]+)?/(.+)$ /public-##username/$2;
        proxy_set_header Upgrade $http_upgrade;
#        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        limit_rate_after 100m;
        limit_rate 32768k;
        limit_conn addr 8;
}

# Classic /~##username/ alias for the public web folder (www/public/), the same
# content /public-##username/ serves. proxy_pass carries a trailing slash so
# nginx replaces the "/~##username/" prefix before forwarding: lighttpd receives
# the path WITHOUT the leading "~", so its url.access-deny = ( "~", ... ) rule is
# never triggered. An alias/root-based implementation would send the literal "~"
# to lighttpd and 403 every request.
location /~##username/ {
        proxy_hide_header WWW-Authenticate;
        proxy_pass http://127.0.0.1:##serverPort/;
        # A page here may not widen a service worker's scope over other paths on this host.
        proxy_hide_header Service-Worker-Allowed;
        proxy_cookie_path /sabnzbd /~##username/sabnzbd;
        proxy_cookie_path /lidarr /~##username/lidarr;
        proxy_cookie_path /radarr /~##username/radarr;
        proxy_cookie_path /prowlarr /~##username/prowlarr;
        proxy_cookie_path /readarr /~##username/readarr;
        proxy_cookie_path /sonarr /~##username/sonarr;
        proxy_cookie_path /jellyfin /~##username/jellyfin;
        proxy_cookie_path /komga /~##username/komga;
        proxy_cookie_path /autobrr /~##username/autobrr;
        proxy_cookie_path /whisparr /~##username/whisparr;
        proxy_redirect ~^(https?://[^/]+)?/(.+)$ /~##username/$2;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        limit_rate_after 100m;
        limit_rate 32768k;
        limit_conn addr 8;
}

location /webdav-##username/ {
        if ($scheme = http) {
                return 301 https://$host$request_uri;
        }
        # WebDAV serves WebDAV clients (no Sec-Fetch-Dest), browser tabs and embedded media; not scripts or frames on a web page.
        if ($http_sec_fetch_dest !~ ^(|document|image|audio|video|track)$) {
                return 403;
        }
        proxy_pass http://127.0.0.1:##serverPort/webdav-##username/;
        # A page here may not widen a service worker's scope over other paths on this host.
        proxy_hide_header Service-Worker-Allowed;
        include /etc/nginx/webdav_proxy_params;
        proxy_http_version 1.1;

        # WebDAV: allow large uploads.
        client_max_body_size 0;

        limit_rate_after 100m;
        limit_rate 102400k;
        limit_conn addr 16;
        error_page 502 /error-502-##username.html;
}

location = /deluge-##username {
    # Legacy Deluge URL path. Keep for compatibility until at least 2028-01-28.
    # Canonical path is /user-##username/deluge/ (served by per-user lighttpd).
    return 308 /deluge-##username/$is_args$args;
}

location /deluge-##username/ {
    # Legacy Deluge URL path: proxy to lighttpd so POST clients don't trip on redirects.
    proxy_pass http://127.0.0.1:##serverPort/deluge-##username/;
    # A tenant's challenge must never replace the shared panel's cached Basic realm.
    proxy_hide_header WWW-Authenticate;
    # A page here may not widen a service worker's scope over other paths on this host.
    proxy_hide_header Service-Worker-Allowed;
    proxy_cookie_path /deluge-##username/ /deluge-##username/;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include /etc/nginx/proxy_params;
    proxy_http_version 1.1;
    limit_rate_after 1024m;
    limit_rate 102400k;
    limit_conn addr 16;
    error_page 502 /error-502-##username.html;
}

location = /error-502-##username.html {
        root /var/www;
        internal;
        try_files $uri /error-502.html;
}
