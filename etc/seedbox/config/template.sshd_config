# PMSS SSH Server Configuration Template for Debian 11
# ---------------------------------------------------------------------------
# This file is intended for use as /etc/ssh/sshd_config on PMSS Seedbox systems.
#
#
# Key modifications include:
#   - PermitRootLogin is enabled for administrative access.
#   - SFTP performance tuning (cipher/MAC order, compression disabled,
#     internal-sftp subsystem).
#   - Additional key exchange algorithms (diffie-hellman-group1-sha1,
#     diffie-hellman-group14-sha1) are appended.
#
# Repository: https://github.com/MagnaCapax/PMSS
#
# OpenSSH defaults are provided in comments; uncomment and modify as required.
# ---------------------------------------------------------------------------

# Port and listening addresses
Port 22
AddressFamily any
ListenAddress 0.0.0.0
ListenAddress ::

# Faster logins
UseDNS no

# Host key files
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Ciphers and key exchange algorithms
# Append legacy CBC ciphers for WHMCS PHP libssh2 compatibility.
# MUST use + prefix (append to defaults), NOT replace. Without +, WHMCS
# cannot negotiate ciphers and provisioning breaks on all servers.
# See: sysadmin memory/lessons/agent/20260223-ssh-hardening-fuckup-all-new-vms-broken.md
Ciphers +aes128-cbc,aes192-cbc,aes256-cbc,chacha20-poly1305@openssh.com
# Enable additional Kex algorithms for legacy WHMCS/libssh2 clients.
KexAlgorithms +diffie-hellman-group-exchange-sha1,diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
HostkeyAlgorithms +ssh-rsa
PubkeyAcceptedKeyTypes +ssh-rsa

# Append legacy MAC for old WHMCS/libssh2 clients.
# MUST use + prefix (append to defaults), same compatibility rule as Ciphers.
MACs +hmac-sha1

# Logging
SyslogFacility AUTH
LogLevel INFO

# Authentication settings
LoginGraceTime 2m
PermitRootLogin yes
StrictModes yes
MaxAuthTries 6
MaxSessions 10

PubkeyAuthentication yes
AuthorizedKeysFile      .ssh/authorized_keys .ssh/authorized_keys2

ChallengeResponseAuthentication no

# PAM authentication support
UsePAM yes

# X11 forwarding
X11Forwarding yes
X11DisplayOffset 10
X11UseLocalhost yes

# Environment settings
AcceptEnv LANG LC_*

# Subsystem for SFTP
Subsystem       sftp    internal-sftp -u 0077

# Authentication methods
# PasswordAuthentication yes
# PermitEmptyPasswords no

# Optional: Additional options (adjust as needed)
# AllowAgentForwarding yes
# AllowTcpForwarding yes
Compression no
ClientAliveInterval 30
ClientAliveCountMax 20

# Optional banner (if you have one)
# Banner /etc/issue.net

# ---------------------------------------------------------------------------
# End of PMSS SSH Server Configuration Template
# ---------------------------------------------------------------------------
