# Debian Trixie repository definition kept in sync by the updater.
deb http://www.nic.funet.fi/debian/ trixie main non-free contrib non-free-firmware
deb-src http://www.nic.funet.fi/debian/ trixie main non-free contrib non-free-firmware

deb http://security.debian.org/debian-security trixie-security main non-free contrib non-free-firmware
deb-src http://security.debian.org/debian-security trixie-security main non-free contrib non-free-firmware

# Trixie updates deliver general bug fixes between point releases.
deb http://www.nic.funet.fi/debian/ trixie-updates main non-free contrib non-free-firmware
deb-src http://www.nic.funet.fi/debian/ trixie-updates main non-free contrib non-free-firmware

deb http://www.nic.funet.fi/debian/ trixie-backports main non-free contrib non-free-firmware

# MediaArea repository
deb https://mediaarea.net/repo/deb/debian trixie main
