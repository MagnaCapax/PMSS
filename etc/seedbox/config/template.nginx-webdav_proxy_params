# WebDAV proxy parameters for large request bodies.
#
# Keep these headers aligned with template.nginx-proxy_params. WebDAV uses a
# separate include so upload-specific timeouts and request streaming do not
# alter application and panel proxy defaults.

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
# RFC 7239 form of the client address and scheme for apps that read it. Quoting assumes IPv4
# listeners (IPv6 needs for="[addr]").
proxy_set_header Forwarded "for=\"$remote_addr\";proto=$scheme";
# ADR 0153: lighttpd reads the scheme only from connections from 127.0.0.2 carrying this header.
proxy_bind 127.0.0.2;
proxy_set_header X-PMSS-Proxy-Hop 127.0.0.1;
proxy_set_header Authorization $http_authorization;
proxy_read_timeout 600s;
proxy_send_timeout 600s;
client_body_timeout 600s;
send_timeout 600s;
proxy_buffering off;
proxy_request_buffering off;

#proxy_pass_header       Authorization;
