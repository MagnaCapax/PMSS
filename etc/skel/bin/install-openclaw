#!/usr/bin/env php
<?php
/** Per-account OpenClaw installer and cron watchdog. Run only as the account owner. */

const OC_NODE_VERSION = '24.21.0';
const OC_NODE_SHA256 = 'fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6';
const OC_CRON_TAG = '# pmss-openclaw';
const OC_REQUIRED_FILES = 60000;

/** Keep all process paths under the caller's own home. */
function ocPaths(?string $home = null): array
{
    $home = $home ?? getenv('HOME');
    if (!is_string($home) || $home === '' || !is_dir($home) || is_link($home)) {
        throw new RuntimeException('HOME must be an existing directory');
    }
    $home = rtrim($home, '/');
    return array(
        'home' => $home,
        'node' => $home.'/.local/share/node-openclaw/bin/node',
        'npm' => $home.'/.local/share/node-openclaw/lib/node_modules/npm/bin/npm-cli.js',
        'entry' => $home.'/.local/share/openclaw/lib/node_modules/openclaw/openclaw.mjs',
        'state' => $home.'/.openclaw',
        'port' => $home.'/.openclaw/gateway.port',
        'env' => $home.'/.openclaw/gateway.env',
        'pid' => $home.'/.openclaw/gateway.pid',
        'check' => $home.'/.openclaw/check.state',
        'npmCache' => $home.'/.local/share/openclaw-npm-cache',
    );
}

/** Install into the private prefix with a private download cache, never the account's own ~/.npm. */
function ocNpmInstallArgs(array $paths): array
{
    return array(
        $paths['node'], $paths['npm'], 'install',
        '--prefix', $paths['home'].'/.local/share/openclaw',
        '--cache', $paths['npmCache'],
        '-g', '--allow-scripts=@google/genai,esbuild,koffi,protobufjs,openclaw', 'openclaw',
    );
}

/** Read only an account-owned, private service key and the Codex-approved HTTPS endpoint. */
function ocVirsilipasCredentials(string $home): ?array
{
    $file = $home.'/.virsilipasKey';
    // Judge the file as it is now: older PHP keeps a cached stat after chmod().
    clearstatcache(true, $file);
    if (!is_file($file) || is_link($file) || fileowner($file) !== posix_geteuid()
        || (fileperms($file) & 0077) !== 0) {
        return null;
    }
    $size = @filesize($file);
    if (!is_int($size) || $size > 4096) {
        return null;
    }
    $contents = @file_get_contents($file);
    $settings = is_string($contents) ? @parse_ini_string($contents, false, INI_SCANNER_RAW) : false;
    $key = is_array($settings) ? ($settings['key'] ?? '') : '';
    $endpoint = is_array($settings) ? ($settings['endpoint'] ?? '') : '';
    if (!is_string($key) || $key === '' || preg_match('/[\s\p{Z}\p{C}]/u', $key) !== 0
        || !is_string($endpoint)
        || !preg_match('#^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$#D', $endpoint)) {
        return null;
    }
    return array('key' => $key, 'endpoint' => $endpoint);
}

/** A prior OpenClaw state directory is an account choice, even if its config is incomplete. */
function ocUseVirsilipas(string $state, ?array $credentials): bool
{
    return !file_exists($state) && !is_link($state) && $credentials !== null;
}

/** Build non-interactive onboarding without putting either secret in argv. */
function ocOnboardArgs(int $port, ?array $credentials): array
{
    $flags = array('onboard', '--non-interactive', '--accept-risk', '--mode', 'local', '--auth-choice', $credentials === null ? 'skip' : 'custom-api-key', '--gateway-auth', 'token', '--gateway-token-ref-env', 'OPENCLAW_GATEWAY_TOKEN', '--gateway-bind', 'loopback', '--gateway-port', (string) $port, '--skip-daemon', '--skip-channels', '--skip-skills', '--skip-health', '--skip-ui', '--suppress-gateway-token-output');
    if ($credentials !== null) {
        array_push($flags, '--custom-base-url', $credentials['endpoint'], '--custom-model-id', 'default', '--custom-provider-id', 'virsilipas', '--custom-compatibility', 'openai', '--secret-input-mode', 'ref');
    }
    return $flags;
}

/** The interactive CLI obtains the current key only when the PMSS provider was installed. */
function ocCliWrapper(array $paths): string
{
    return "#!/bin/sh\nPATH=".escapeshellarg(dirname($paths['node'])).":\$PATH\nexport PATH\n"
        ."if [ -z \"\${CUSTOM_API_KEY+x}\" ] && [ -f \"\$HOME/.openclaw/pmss-virsilipas\" ]; then\n"
        ."  # The PHP expression is intentionally single-quoted for the shell.\n  # shellcheck disable=SC2016\n"
        ."  CUSTOM_API_KEY=\$(php -r 'ob_start(); require getenv(\"HOME\").\"/bin/install-openclaw\"; ob_end_clean(); \$c=ocVirsilipasCredentials(getenv(\"HOME\")); if (\$c !== null) echo \$c[\"key\"];')\n"
        ."  [ -z \"\$CUSTOM_API_KEY\" ] || export CUSTOM_API_KEY\nfi\nexec "
        .escapeshellarg($paths['node']).' '.escapeshellarg($paths['entry'])." \"\$@\"\n";
}

/** Return the first-line PMSS port only if it has the media-stack marker shape. */
function ocReservedPort(string $path): ?int
{
    if (!is_file($path) || is_link($path)) {
        return null;
    }
    $handle = @fopen($path, 'rb');
    $line = $handle ? fgets($handle, 32) : false;
    if ($handle) {
        fclose($handle);
    }
    if (!is_string($line) || !preg_match('/^[0-9]{1,5}(?:\r?\n|$)/D', $line)) {
        return null;
    }
    $port = (int) $line;
    return $port >= 1 && $port <= 65535 ? $port : null;
}

/** Run an argument vector, capturing output without shell interpolation. */
function ocRun(array $args, ?array $env = null): array
{
    $command = implode(' ', array_map('escapeshellarg', $args));
    $process = proc_open($command.' 2>&1', array(0 => array('pipe', 'r'), 1 => array('pipe', 'w')), $pipes, null, $env);
    if (!is_resource($process)) {
        return array(1, 'Could not launch command');
    }
    fclose($pipes[0]);
    $output = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    return array(proc_close($process), (string) $output);
}

/** Read the file columns from a plain quota row; zero soft limit is unlimited. */
function ocQuotaFileHeadroom(string $quotaOutput): ?array
{
    foreach (preg_split('/\r?\n/', $quotaOutput) as $line) {
        if (!preg_match('/^\s*\/\S+\s+\d+\*?\s+\d+\s+\d+\s+(?:\S+\s+)?(\d+)\*?\s+(\d+)\s+(\d+)(?:\s+\S+)?\s*$/D', $line, $match)) {
            continue;
        }
        $used = filter_var($match[1], FILTER_VALIDATE_INT);
        $soft = filter_var($match[2], FILTER_VALIDATE_INT);
        $hard = filter_var($match[3], FILTER_VALIDATE_INT);
        if ($used !== false && $soft !== false && $hard !== false && $soft > 0) {
            return array('used' => $used, 'soft' => $soft, 'hard' => $hard);
        }
    }
    return null;
}

/** Preserve every foreign crontab byte; manage only trailing PMSS lines. */
function ocCronMerge(string $current, string $home, bool $install): string
{
    $lines = preg_split('/(?<=\n)/', $current, -1, PREG_SPLIT_NO_EMPTY);
    $kept = '';
    foreach ($lines as $line) {
        if (preg_match('/# pmss-openclaw\r?\n?$/D', $line) !== 1) {
            $kept .= $line;
        }
    }
    if (!$install) {
        return $kept;
    }
    if ($kept !== '' && substr($kept, -1) !== "\n") {
        $kept .= "\n";
    }
    return $kept."@reboot php \$HOME/bin/install-openclaw check ".OC_CRON_TAG."\n"
        ."* * * * * php \$HOME/bin/install-openclaw check ".OC_CRON_TAG."\n";
}

/** Install a crontab from a private temporary file, leaving other jobs alone. */
function ocCronApply(array $paths, bool $install): void
{
    list($rc, $current) = ocRun(array('crontab', '-l'));
    if ($rc !== 0 && strpos($current, 'no crontab for') === false) {
        throw new RuntimeException('Could not read crontab: '.$current);
    }
    if ($rc !== 0) {
        $current = '';
    }
    $merged = ocCronMerge($current, $paths['home'], $install);
    if ($merged === $current) {
        return;
    }
    $temp = tempnam($paths['home'], '.openclaw-cron-');
    if ($temp === false) {
        throw new RuntimeException('Could not stage crontab');
    }
    try {
        chmod($temp, 0600);
        file_put_contents($temp, $merged);
        list($rc, $output) = ocRun(array('crontab', $temp));
        if ($rc !== 0) {
            throw new RuntimeException('Could not update crontab: '.$output);
        }
    } finally {
        unlink($temp);
    }
}

/** A failed launch counts once; the fifth failure permanently gates checks. */
function ocNextCheckState(string $state, bool $healthy, int $time): string
{
    if ($healthy) {
        return 'healthy 0 '.$time."\n";
    }
    if (strpos($state, 'gave_up ') === 0) {
        return $state;
    }
    $count = preg_match('/^failed ([0-4]) /', $state, $match) ? (int) $match[1] : 0;
    ++$count;
    return ($count >= 5 ? 'gave_up ' : 'failed '.$count.' ').$time."\n";
}

/** Private env contents are accepted only with an account-owned 0600 file. */
function ocGatewayEnv(array $paths): array
{
    $file = $paths['env'];
    if (!is_file($file) || is_link($file) || (fileperms($file) & 0077) !== 0 || fileowner($file) !== posix_geteuid()) {
        throw new RuntimeException('Gateway token file is absent or insecure');
    }
    $contents = (string) file_get_contents($file);
    if (!preg_match('/^OPENCLAW_GATEWAY_TOKEN=([a-f0-9]{64})\n?$/D', $contents, $match)) {
        throw new RuntimeException('Gateway token file is invalid');
    }
    $env = getenv();
    $env['OPENCLAW_GATEWAY_TOKEN'] = $match[1];
    $marker = isset($paths['state']) ? $paths['state'].'/pmss-virsilipas' : null;
    if ($marker !== null && isset($paths['home']) && is_file($marker) && !is_link($marker)
        && !isset($env['CUSTOM_API_KEY'])) {
        $credentials = ocVirsilipasCredentials($paths['home']);
        if ($credentials !== null) {
            $env['CUSTOM_API_KEY'] = $credentials['key'];
        }
    }
    $env['PATH'] = dirname($paths['node']).':'.($env['PATH'] ?? '/usr/bin:/bin');
    // The gateway runs npm itself (global root/prefix lookups, plugins); keep that under ~/.openclaw so --purge removes it.
    $env['npm_config_cache'] = $paths['state'].'/npm-cache';
    return $env;
}

/** Match the entry path or one of OpenClaw's exact rewritten process titles. */
function ocCmdlineIsGateway(string $cmdline, string $entry): bool
{
    if (strpos($cmdline, $entry) !== false) {
        return true;
    }
    $first = strtok($cmdline, "\0 \t\r\n");
    return $first === 'openclaw' || $first === 'openclaw-gateway';
}

/** Check UID, executable and command line before signaling a recorded PID. */
function ocRunningPid(array $paths): ?int
{
    $pid = is_file($paths['pid']) && !is_link($paths['pid']) ? trim((string) file_get_contents($paths['pid'])) : '';
    if (!preg_match('/^[1-9][0-9]*$/D', $pid)) {
        return null;
    }
    $proc = '/proc/'.$pid;
    $cmd = @file_get_contents($proc.'/cmdline');
    $exe = @readlink($proc.'/exe');
    $owner = @fileowner($proc);
    if ($owner !== posix_geteuid() || $exe !== realpath($paths['node']) || !is_string($cmd)
        || !ocCmdlineIsGateway($cmd, $paths['entry'])) {
        return null;
    }
    return (int) $pid;
}

/** Existing credentials survive repeat installs; new files are private from creation. */
function ocEnsureToken(array $paths): void
{
    if (file_exists($paths['env']) || is_link($paths['env'])) {
        ocGatewayEnv($paths);
        return;
    }
    $old = umask(0077);
    try {
        $handle = @fopen($paths['env'], 'x');
        if ($handle === false) {
            throw new RuntimeException('Could not create gateway token');
        }
        $content = 'OPENCLAW_GATEWAY_TOKEN='.bin2hex(random_bytes(32))."\n";
        if (fwrite($handle, $content) !== strlen($content)) {
            fclose($handle);
            throw new RuntimeException('Could not write gateway token');
        }
        fclose($handle);
    } finally {
        umask($old);
    }
}

/** Download one pinned archive and verify it before extraction. */
function ocInstallNode(array $paths): void
{
    if (is_file($paths['node']) && is_executable($paths['node'])) {
        list($rc, $version) = ocRun(array($paths['node'], '--version'));
        if ($rc === 0 && trim($version) === 'v'.OC_NODE_VERSION) {
            return;
        }
    }
    $base = $paths['home'].'/.local/share';
    if (!is_dir($base) && !mkdir($base, 0700, true)) {
        throw new RuntimeException('Could not prepare local share directory');
    }
    $work = $base.'/.node-openclaw-'.bin2hex(random_bytes(6));
    mkdir($work, 0700);
    $archive = $work.'/node.tar.xz';
    $name = 'node-v'.OC_NODE_VERSION.'-linux-x64.tar.xz';
    list($rc, $out) = ocRun(array('curl', '-fsSL', '--connect-timeout', '15', '--max-time', '300', 'https://nodejs.org/dist/v'.OC_NODE_VERSION.'/'.$name, '-o', $archive));
    if ($rc !== 0 || !is_file($archive) || !hash_equals(OC_NODE_SHA256, hash_file('sha256', $archive))) {
        throw new RuntimeException('Node download or SHA256 verification failed: '.$out);
    }
    $stage = $work.'/node';
    mkdir($stage, 0700);
    list($rc, $out) = ocRun(array('tar', '-xJf', $archive, '--strip-components=1', '-C', $stage));
    if ($rc !== 0) {
        throw new RuntimeException('Node extraction failed: '.$out);
    }
    $target = dirname($paths['node'], 2);
    $backup = $work.'/previous';
    if ((file_exists($target) || is_link($target)) && !rename($target, $backup)) {
        throw new RuntimeException('Could not move the previous Node version');
    }
    if (!rename($stage, $target)) {
        if (is_dir($backup)) {
            rename($backup, $target);
        }
        throw new RuntimeException('Could not publish Node');
    }
    ocRemoveTree($work);
}

/** Remove only the installer's fixed directories; never traverse symlinks. */
function ocRemoveTree(string $path): void
{
    if (is_link($path) || is_file($path)) {
        unlink($path);
    } elseif (is_dir($path)) {
        foreach (new DirectoryIterator($path) as $entry) {
            if (!$entry->isDot()) {
                ocRemoveTree($entry->getPathname());
            }
        }
        rmdir($path);
    }
}

/** OpenClaw runs with the pinned interpreter and a token from the private env. */
function ocCli(array $paths, array $args, ?array $env = null): array
{
    return ocRun(array_merge(array($paths['node'], $paths['entry']), $args), $env);
}

/** Stop only a verified account-owned process. */
function ocStop(array $paths): void
{
    $pid = ocRunningPid($paths);
    if ($pid === null) {
        return;
    }
    posix_kill($pid, SIGTERM);
    for ($i = 0; $i < 10 && ocRunningPid($paths) !== null; ++$i) {
        usleep(200000);
    }
    if (ocRunningPid($paths) === $pid) {
        posix_kill($pid, SIGKILL);
    }
}

/** Probe only the account's reserved loopback listener. */
function ocPortListening(?int $port): bool
{
    if ($port === null) {
        return false;
    }
    $socket = @fsockopen('127.0.0.1', $port, $error, $message, 1);
    if ($socket === false) {
        return false;
    }
    fclose($socket);
    return true;
}

/** Launch detached; wait for readiness without treating a slow gateway as failed. */
function ocStart(array $paths, bool $reset, int $waitSeconds): bool
{
    $env = ocGatewayEnv($paths);
    $port = ocReservedPort($paths['home'].'/.media-stack-port-openclaw');
    if ($port === null) {
        throw new RuntimeException('No PMSS-reserved port yet; run a full PMSS update first');
    }
    if (!is_file($paths['entry'])) {
        throw new RuntimeException('OpenClaw is not installed');
    }
    list($rc, $auth) = ocCli($paths, array('config', 'get', 'gateway.auth.mode'), $env);
    if ($rc !== 0 || trim($auth, " \t\r\n\"") !== 'token') {
        throw new RuntimeException('Gateway token authentication is not configured');
    }
    file_put_contents($paths['port'], $port."\n");
    if ($reset) {
        file_put_contents($paths['check'], "healthy 0 ".time()."\n");
    }
    if (ocRunningPid($paths) !== null) {
        return true;
    }
    $log = $paths['state'].'/logs/gateway.log';
    if (!is_dir(dirname($log))) {
        mkdir(dirname($log), 0700, true);
    }
    $command = 'nohup setsid '.escapeshellarg($paths['node']).' '.escapeshellarg($paths['entry'])
        .' gateway run --bind loopback --port '.escapeshellarg((string) $port)
        .' </dev/null >>'.escapeshellarg($log).' 2>&1 & echo $!';
    $process = proc_open($command, array(0 => array('pipe', 'r'), 1 => array('pipe', 'w'), 2 => array('pipe', 'w')), $pipes, null, $env);
    if (!is_resource($process)) {
        return false;
    }
    fclose($pipes[0]);
    $pid = trim((string) stream_get_contents($pipes[1]));
    fclose($pipes[1]);
    fclose($pipes[2]);
    proc_close($process);
    if (!preg_match('/^[1-9][0-9]*$/D', $pid)) {
        return false;
    }
    file_put_contents($paths['pid'], $pid."\n");
    for ($waited = 0; $waited < $waitSeconds; ++$waited) {
        sleep(1);
        if (ocRunningPid($paths) === null) {
            return false;
        }
        if (ocPortListening($port)) {
            return true;
        }
    }
    echo "Gateway is still starting; check `install-openclaw status` in a minute.\n";
    return true;
}

/** One cron check at a time; five consecutive failures require manual start. */
function ocCheck(array $paths): void
{
    if (is_file($paths['state'].'/pmss-stopped')) {
        return;
    }
    $lock = fopen($paths['home'].'/.openclaw-action.lock', 'c');
    if (!$lock || !flock($lock, LOCK_EX | LOCK_NB)) {
        return;
    }
    $adopted = ocPendingProviderApply($paths);
    if ($adopted) {
        ocStop($paths);
    }
    $prior = is_file($paths['check']) ? (string) file_get_contents($paths['check']) : '';
    if ($adopted) $prior = '';
    if (strpos($prior, 'gave_up ') === 0) {
        return;
    }
    $healthy = ocRunningPid($paths) !== null;
    if (!$healthy) {
        try {
            $healthy = ocStart($paths, false, 5);
        } catch (Throwable $error) {
            fwrite(STDERR, $error->getMessage()."\n");
        }
    }
    file_put_contents($paths['check'], ocNextCheckState($prior, $healthy, time()));
    flock($lock, LOCK_UN);
    fclose($lock);
}

/** Use the panel's hostname source, never an untrusted request Host header. */
function ocPublicOrigin(): string
{
    $host = function_exists('gethostname') ? (string) gethostname() : '';
    $host = $host !== '' ? $host : (string) php_uname('n');
    if (!preg_match('/^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$/D', $host)) {
        throw new RuntimeException('Canonical panel hostname is invalid');
    }
    return 'https://'.$host;
}

/** The full account prefix is also the gateway's asset and websocket prefix. */
function ocBasePath(array $paths): string
{
    $user = basename($paths['home']);
    // Same account-name rule as scripts/lib/user/identity.php (legacy names can be 1-2 characters).
    if (!preg_match('/^[a-z][a-z0-9]{0,7}$/D', $user)) {
        throw new RuntimeException('Invalid account name');
    }
    return '/user-'.$user.'/openclaw';
}

/** Embed the shared keep-prefix rule: the customer cannot include /scripts. */
function ocProxyFragment(string $base, int $port): string
{
    return '$HTTP["url"] =~ "^'.$base.'($|/)" {'."\n"
        ."  proxy.server = ( \"\" => ( (\n    \"host\" => \"127.0.0.1\",\n    \"port\" => {$port}\n  ) ) ),\n"
        ."  proxy.header = (\n      \"upgrade\" => \"enable\"\n  )\n}";
}

/** Resolve a binary from PATH, then the sbin dirs an account login PATH omits (lighttpd lives in /usr/sbin). */
function ocCommandPath(string $name): string
{
    $dirs = array_merge(explode(':', (string) getenv('PATH')), array('/usr/sbin', '/sbin'));
    foreach ($dirs as $dir) {
        if ($dir !== '' && is_file($dir.'/'.$name) && is_executable($dir.'/'.$name)) return $dir.'/'.$name;
    }
    return $name;
}

/** Restart exactly the account's web processes, as the media-stack installer does. */
function ocPanelRestart(array $paths): bool
{
    $lighttpd = ocCommandPath('lighttpd');
    list($rc) = ocRun(array($lighttpd, '-tt', '-f', $paths['home'].'/.lighttpd.conf'));
    if ($rc !== 0) return false;
    foreach (array('lighttpd', 'php-cgi') as $name) {
        ocRun(array('pkill', '-9', '-u', (string) posix_geteuid(), $name));
    }
    list($rc) = ocRun(array($lighttpd, '-f', $paths['home'].'/.lighttpd.conf'));
    if ($rc !== 0) {
        return false;
    }
    $config = @file_get_contents($paths['home'].'/.lighttpd.conf');
    if (!is_string($config) || !preg_match('/^\s*server\.port\s*=\s*([0-9]+)\s*$/m', $config, $match)) {
        return false;
    }
    for ($attempt = 0; $attempt < 10; ++$attempt) {
        // A 401 is the expected proof that the account's Basic realm is alive.
        list($rc, $code) = ocRun(array('curl', '-s', '-o', '/dev/null', '-w', '%{http_code}', '--max-time', '2',
            'http://127.0.0.1:'.$match[1].'/user-'.basename($paths['home']).'/'));
        if ($rc === 0 && in_array(trim($code), array('200', '301', '302', '401'), true)) {
            return true;
        }
        usleep(200000);
    }
    return false;
}

/** Publish only the opted-in fragment; failed restarts remove it and restore the panel. */
function ocProxyApply(array $paths, ?int $port, ?callable $restart = null): void
{
    $dir = $paths['home'].'/.lighttpd/custom.d';
    foreach (array(dirname($dir), $dir, $dir.'/openclaw.conf') as $path) {
        if (is_link($path) || (file_exists($path) && !is_dir($path) && $path !== $dir.'/openclaw.conf')) {
            throw new RuntimeException('Unsafe OpenClaw proxy path');
        }
    }
    $file = $dir.'/openclaw.conf';
    if ($port !== null) {
        if (!is_dir($dir) && !mkdir($dir, 0700, true)) {
            throw new RuntimeException('Could not create proxy directory');
        }
        $fragment = ocProxyFragment(ocBasePath($paths), $port);
        if (file_put_contents($file, $fragment) !== strlen($fragment)) {
            @unlink($file);
            throw new RuntimeException('Could not write OpenClaw proxy');
        }
    } elseif (file_exists($file) && !unlink($file)) {
        throw new RuntimeException('Could not remove OpenClaw proxy');
    }
    $restart = $restart ?? 'ocPanelRestart';
    if (!$restart($paths)) {
        @unlink($file);
        $recovered = $restart($paths);
        throw new RuntimeException('OpenClaw proxy failed; fragment removed. '.($recovered ? 'Account panel recovered.' : 'Account panel restart still failed; contact support.'));
    }
}

/** Set browser configuration without changing the gateway's token authentication. */
function ocBrowserConfigure(array $paths, int $port): void
{
    $env = ocGatewayEnv($paths);
    list($rc, $auth) = ocCli($paths, array('config', 'get', 'gateway.auth.mode'), $env);
    if ($rc !== 0 || trim($auth, " \t\r\n\"") !== 'token') {
        throw new RuntimeException('Gateway token authentication is not configured');
    }
    foreach (array('gateway.controlUi.basePath' => ocBasePath($paths),
        'gateway.publicOrigin' => ocPublicOrigin(), 'gateway.trustedProxies' => '["127.0.0.1"]') as $key => $value) {
        list($rc) = ocCli($paths, array('config', 'set', $key, $value), $env);
        if ($rc !== 0) {
            throw new RuntimeException('Could not configure OpenClaw browser access: '.$key);
        }
    }
    ocProxyApply($paths, $port);
}

/** Validate the loopback handoff, retaining bootstrap fields and replacing only origins. */
function ocDashboardUrlRewrite(string $json, string $origin, string $base, ?int $port): string
{
    $data = json_decode($json, true);
    $url = is_array($data) ? ($data['browserUrl'] ?? null) : null;
    $parts = is_string($url) && !preg_match('/[\x00-\x20\x7f]/', $url) ? parse_url($url) : false;
    if (!is_array($parts) || ($parts['scheme'] ?? '') !== 'http' || ($parts['host'] ?? '') !== '127.0.0.1'
        || ($parts['port'] ?? null) !== $port || ($parts['path'] ?? '') !== $base.'/'
        || isset($parts['user']) || isset($parts['pass']) || isset($parts['query'])
        || !preg_match('#^https://[A-Za-z0-9.-]+$#D', $origin)) {
        throw new RuntimeException('Unexpected OpenClaw dashboard JSON shape');
    }
    parse_str($parts['fragment'] ?? '', $fragment);
    foreach (array('bootstrapToken', 'bootstrapProfile', 'gatewayUrl') as $key) {
        if (!isset($fragment[$key]) || !is_string($fragment[$key]) || $fragment[$key] === ''
            || preg_match('/[\x00-\x1f\x7f]/', $fragment[$key])) {
            throw new RuntimeException('Unexpected OpenClaw dashboard JSON fields');
        }
    }
    $gateway = parse_url($fragment['gatewayUrl']);
    if (isset($fragment['token']) || !is_array($gateway) || ($gateway['scheme'] ?? '') !== 'ws'
        || ($gateway['host'] ?? '') !== '127.0.0.1' || ($gateway['port'] ?? null) !== $port
        || isset($gateway['user']) || isset($gateway['pass']) || isset($gateway['query']) || isset($gateway['fragment'])
        || !in_array($gateway['path'] ?? '', array('', '/', $base, $base.'/'), true)) {
        throw new RuntimeException('Unexpected OpenClaw dashboard gateway URL');
    }
    $fragment['gatewayUrl'] = 'wss://'.substr($origin, 8).$base;
    return $origin.$base.'/#'.http_build_query($fragment, '', '&', PHP_QUERY_RFC3986);
}

/** Private marker creation never inherits a permissive account umask. */
function ocPrivateMarkerWrite(string $path, string $contents): void
{
    $old = umask(0077);
    try {
        if (is_link($path) || file_put_contents($path, $contents) !== strlen($contents) || !chmod($path, 0600)) {
            throw new RuntimeException('Could not write OpenClaw state marker');
        }
    } finally {
        umask($old);
    }
}

/** The user's primary model always wins over delayed platform credentials. */
function ocPendingProviderDecision(bool $pending, ?array $credentials, $primary): string
{
    if (!$pending) return 'none';
    if ($primary !== null && $primary !== '') return 'remove';
    return $credentials === null ? 'wait' : 'apply';
}

/** Adopt a late key once; the cron caller owns the single restart. */
function ocPendingProviderApply(array $paths): bool
{
    $marker = $paths['state'].'/pmss-provider-pending';
    if (!is_file($marker)) return false;
    $raw = @file_get_contents($paths['state'].'/openclaw.json');
    $config = is_string($raw) ? json_decode($raw, true) : null;
    if (!is_array($config)) return false;
    $credentials = ocVirsilipasCredentials($paths['home']);
    $model = $config['agents']['defaults']['model'] ?? null;
    // Preserve a user's scalar model shorthand as well as the explicit primary field.
    $primary = is_array($model) ? ($model['primary'] ?? null) : $model;
    $decision = ocPendingProviderDecision(true, $credentials, $primary);
    if ($decision === 'remove') { unlink($marker); return false; }
    if ($decision !== 'apply') return false;
    $provider = array('baseUrl' => $credentials['endpoint'],
        'apiKey' => array('source' => 'env', 'provider' => 'default', 'id' => 'CUSTOM_API_KEY'),
        'api' => 'openai-completions', 'models' => array(array('id' => 'default', 'name' => 'default (Custom Provider)')));
    $env = ocGatewayEnv($paths);
    $env['CUSTOM_API_KEY'] = $credentials['key'];
    foreach (array('models.providers.virsilipas' => json_encode($provider), 'agents.defaults.model.primary' => 'virsilipas/default') as $key => $value) {
        list($rc) = ocCli($paths, array('config', 'set', $key, $value), $env);
        if ($rc !== 0) throw new RuntimeException('Could not apply pending OpenClaw provider');
        // Publish the runtime key reader before making this provider the active model.
        if ($key === 'models.providers.virsilipas') ocPrivateMarkerWrite($paths['state'].'/pmss-virsilipas', "virsilipas\n");
    }
    unlink($marker);
    return true;
}

/** Bootstrap missing program files without repeating onboarding on existing installs. */
function ocInstallFresh(array $paths, ?array $credentials, bool $useVirsilipas, int $port): bool
{
    ocInstallNode($paths);
    $env = getenv();
    $env['PATH'] = dirname($paths['node']).':'.($env['PATH'] ?? '/usr/bin:/bin');
    list($rc, $output) = ocRun(ocNpmInstallArgs($paths), $env);
    ocRemoveTree($paths['npmCache']);
    if ($rc !== 0) {
        if (strpos($output, '-122') !== false || strpos($output, 'EDQUOT') !== false) {
            throw new RuntimeException('npm install failed: the account file-count quota was reached.');
        }
        throw new RuntimeException('npm install failed: '.$output);
    }
    if (!is_file($paths['entry'])) {
        throw new RuntimeException('npm did not install the OpenClaw entry point');
    }
    if (!is_dir($paths['state'])) {
        mkdir($paths['state'], 0700);
    }
    ocEnsureToken($paths);
    $env = ocGatewayEnv($paths);
    list($rc, $help) = ocCli($paths, array('onboard', '--help'), $env);
    foreach (array('--non-interactive', '--accept-risk', '--skip-daemon', '--skip-channels', '--gateway-token-ref-env') as $flag) {
        if ($rc !== 0 || strpos($help, $flag) === false) {
            throw new RuntimeException('Installed OpenClaw onboarding lacks '.$flag);
        }
    }
    if ($useVirsilipas) {
        // A release without the custom-provider flags keeps the skipped-provider install.
        foreach (array('--custom-base-url', '--custom-model-id', '--custom-provider-id', '--custom-compatibility', '--secret-input-mode') as $flag) {
            if (strpos($help, $flag) === false) {
                $useVirsilipas = false;
            }
        }
    }
    if ($useVirsilipas) {
        $env['CUSTOM_API_KEY'] = $credentials['key'];
    }
    $flags = ocOnboardArgs($port, $useVirsilipas ? $credentials : null);
    list($rc, $output) = ocCli($paths, $flags, $env);
    if ($rc !== 0) {
        throw new RuntimeException('Onboarding failed; see OpenClaw diagnostics.');
    }
    if ($useVirsilipas) {
        $marker = $paths['state'].'/pmss-virsilipas';
        if (file_put_contents($marker, "virsilipas\n") !== strlen("virsilipas\n") || !chmod($marker, 0600)) {
            throw new RuntimeException('Could not mark the Virsilipas runtime configuration');
        }
    }
    return $useVirsilipas;
}

/** One entry point keeps include-only test calls hermetic. */
function ocMain(array $args): int
{
    $command = $args[1] ?? '';
    if (!in_array($command, array('install', 'start', 'stop', 'status', 'check', 'uninstall', 'open-url'), true)) {
        echo "Usage: install-openclaw install [--yes] | start | stop | status [--show-token] | check | open-url | uninstall [--purge]\n";
        return $command === '' ? 0 : 1;
    }
    if (function_exists('posix_geteuid') && posix_geteuid() === 0) {
        throw new RuntimeException('Run as your own account, not root');
    }
    $paths = ocPaths();
    // Share the cron lock so start/stop/install cannot race a watchdog restart.
    $actionLock = null;
    if ($command !== 'check' && $command !== 'status' && $command !== 'open-url') {
        $actionLock = fopen($paths['home'].'/.openclaw-action.lock', 'c');
        if (!$actionLock || !flock($actionLock, LOCK_EX | LOCK_NB)) {
            throw new RuntimeException('Another OpenClaw action is running');
        }
    }
    if ($command === 'open-url') {
        if (ocRunningPid($paths) === null || !ocPortListening(ocReservedPort($paths['port']))) {
            throw new RuntimeException('Gateway is stopped; start OpenClaw first.');
        }
        list($rc, $json) = ocCli($paths, array('dashboard', '--json', '--no-open'), ocGatewayEnv($paths));
        if ($rc !== 0) {
            throw new RuntimeException('Could not create an OpenClaw dashboard handoff.');
        }
        echo ocDashboardUrlRewrite($json, ocPublicOrigin(), ocBasePath($paths), ocReservedPort($paths['port']))."\n";
        return 0;
    }
    if ($command === 'install') {
        echo "OpenClaw is a chat-driven agent with shell access to this account. Its gateway or bot token equals shell access.\n";
        if (!in_array('--yes', $args, true)) {
            echo 'Continue? [y/N] ';
            if (strtolower(trim((string) fgets(STDIN))) !== 'y') {
                return 1;
            }
        }
        $port = ocReservedPort($paths['home'].'/.media-stack-port-openclaw');
        if ($port === null) {
            throw new RuntimeException('No PMSS-reserved port yet; run a full PMSS update first');
        }
        list($quotaRc, $quotaOutput) = ocRun(array('quota', '-w', '-p', '-u'));
        $files = $quotaRc === 0 ? ocQuotaFileHeadroom($quotaOutput) : null;
        if (!is_file($paths['entry']) && $files !== null && $files['used'] > $files['soft'] - OC_REQUIRED_FILES) {
            throw new RuntimeException('OpenClaw needs '.OC_REQUIRED_FILES.' files; '.$files['used'].' files are currently used and the account file limit is '.$files['soft'].'. Installing would exceed the account file-count quota.');
        }
        $credentials = ocVirsilipasCredentials($paths['home']);
        $useVirsilipas = ocUseVirsilipas($paths['state'], $credentials);
        // Existing installations only need browser reconciliation, never another onboarding.
        if (!is_file($paths['entry'])) {
            $useVirsilipas = ocInstallFresh($paths, $credentials, $useVirsilipas, $port);
        }
        ocEnsureToken($paths);
        if ($credentials === null) {
            ocPrivateMarkerWrite($paths['state'].'/pmss-provider-pending', "pending\n");
        }
        $wrapper = ocCliWrapper($paths);
        if (!is_dir($paths['home'].'/bin')) {
            mkdir($paths['home'].'/bin', 0750);
        }
        file_put_contents($paths['home'].'/bin/openclaw', $wrapper);
        chmod($paths['home'].'/bin/openclaw', 0750);
        file_put_contents($paths['port'], $port."\n");
        ocBrowserConfigure($paths, $port);
        ocStop($paths);
        @unlink($paths['state'].'/pmss-stopped');
        ocCronApply($paths, true);
        if (!ocStart($paths, true, 120)) {
            throw new RuntimeException('Gateway did not stay running; inspect ~/.openclaw/logs/gateway.log');
        }
        if ($useVirsilipas) {
            echo "Installed on loopback port {$port}. OpenClaw is set to use your Pulsed Media AI credits; change it with: ~/bin/openclaw configure\n";
        } else {
            echo "Installed on loopback port {$port}. Configure your model provider with: ~/bin/openclaw configure\n";
        }
        return 0;
    }
    if ($command === 'uninstall') {
        ocStop($paths);
        ocCronApply($paths, false);
        ocProxyApply($paths, null);
        foreach (array($paths['home'].'/bin/openclaw', $paths['pid']) as $file) {
            if (is_file($file) || is_link($file)) {
                unlink($file);
            }
        }
        ocRemoveTree($paths['home'].'/.local/share/openclaw');
        ocRemoveTree($paths['home'].'/.local/share/node-openclaw');
        ocRemoveTree($paths['npmCache']);
        echo "Cron entries, wrapper, and program files removed.\n";
        if (in_array('--purge', $args, true)) {
            ocRemoveTree($paths['state']);
            echo "OpenClaw configuration and data removed.\n";
        }
        return 0;
    }
    if ($command === 'status') {
        $pid = ocRunningPid($paths);
        $port = ocReservedPort($paths['port']);
        $state = is_file($paths['check']) ? trim((string) file_get_contents($paths['check'])) : 'never checked';
        $node = is_file($paths['node']) ? trim((string) ocRun(array($paths['node'], '--version'))[1]) : 'missing';
        $version = is_file($paths['entry']) ? trim((string) ocCli($paths, array('--version'))[1]) : 'missing';
        echo 'Gateway: '.($pid === null ? 'stopped' : 'running').' pid='.($pid ?? '-').' port='.($port ?? '-').' listening='.(ocPortListening($port) ? 'yes' : 'no')."\n";
        echo "Check: {$state}\nNode: {$node}\nOpenClaw: {$version}\n";
        if (in_array('--show-token', $args, true)) {
            echo 'Token: '.ocGatewayEnv($paths)['OPENCLAW_GATEWAY_TOKEN']."\n";
        }
        return 0;
    }
    if ($command === 'stop') {
        if (is_dir($paths['state'])) ocPrivateMarkerWrite($paths['state'].'/pmss-stopped', "stopped\n");
        ocStop($paths);
        echo "Gateway stopped.\n";
        return 0;
    }
    if ($command === 'start') {
        if (!is_file($paths['home'].'/.lighttpd/custom.d/openclaw.conf')) {
            $port = ocReservedPort($paths['home'].'/.media-stack-port-openclaw');
            if ($port === null) throw new RuntimeException('No PMSS-reserved port yet');
            ocBrowserConfigure($paths, $port);
            ocStop($paths);
        }
        @unlink($paths['state'].'/pmss-stopped');
        if (!ocStart($paths, true, 120)) {
            throw new RuntimeException('Gateway did not stay running');
        }
        ocCronApply($paths, true);
        echo "Gateway running.\n";
        return 0;
    }
    ocCheck($paths);
    return 0;
}

if (isset($_SERVER['SCRIPT_FILENAME']) && realpath($_SERVER['SCRIPT_FILENAME']) === __FILE__) {
    try {
        exit(ocMain($argv));
    } catch (Throwable $error) {
        fwrite(STDERR, $error->getMessage()."\n");
        exit(1);
    }
}
