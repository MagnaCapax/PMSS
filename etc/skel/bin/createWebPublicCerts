#!/usr/bin/env php
<?php
/**
 * createWebPublicCerts — request a real HTTPS certificate for your public web
 * folder's service permalink, optionally including the username hostname.
 *
 * Runs as the CUSTOMER. It cannot issue the certificate itself — certificate
 * issuance needs root (it writes under /etc/letsencrypt and answers the ACME
 * challenge on the server's port 80). So this script records your request; a
 * root-side job (scripts/cron/webPublicCertsProcess.php) picks it up within a
 * few minutes, issues the certificate for your public hostnames, and switches
 * your public site over to it. This is opt-in on purpose — most accounts never
 * need it, and issuing one per account for the whole fleet would be wasteful.
 *
 * Idempotent: running it again just re-affirms the request.
 *
 * @license GPL-3.0-only
 * @author PMSS Team
 */

$home = getenv('HOME');
if ($home === false || $home === '' || !is_dir($home)) {
    fwrite(STDERR, "Cannot determine your home directory.\n");
    exit(1);
}

if ($argc > 2 || ($argc === 2 && $argv[1] !== '--with-username-hostname')) {
    fwrite(STDERR, "Usage: createWebPublicCerts [--with-username-hostname]\n");
    exit(2);
}
$withUsername = $argc === 2;

// Same two-file order, and the same strictness, as pmssUserBillingServiceIdDigitsRead():
// .billingServiceId first, then the legacy .billingId. That canonical reader lives
// under the root-owned /scripts tree, which the customer UID cannot read (ADR 0016),
// so it is re-implemented inline here the way the rest of this script avoids
// operator-tree code. Without the fallback, an account still on .billingId -- the
// whole migration window -- is told about one hostname while webPublicCertsProcess.php
// issues a certificate covering two.
$billingDigitsRead = static function (string $path): string {
    if (!is_file($path) || is_link($path)) {
        return '';
    }
    $raw = @file_get_contents($path, false, null, 0, 64);
    if (!is_string($raw)) {
        return '';
    }
    // Reject rather than salvage: a file that is not purely digits yields no service
    // id in the root-side reader either, and the two must not disagree.
    $raw = trim($raw);
    return ($raw !== '' && ctype_digit($raw) && (int) $raw > 0) ? $raw : '';
};

$serviceId = $billingDigitsRead($home.'/.billingServiceId');
if ($serviceId === '') {
    $serviceId = $billingDigitsRead($home.'/.billingId');
}
$serverFqdn = trim((string) @shell_exec('hostname -f'));
$user = basename($home);

echo "Public HTTPS certificate request\n";
echo "================================\n\n";
if (!$withUsername && $serviceId === '') {
    echo "This account has no service permalink yet, so there is nothing to certify without the username.\n";
    echo "Use --with-username-hostname to request the username hostname instead.\n";
    exit(1);
}

echo "Your public web folder (~/www/public/) will have HTTPS at:\n";
if ($serviceId !== '') {
    // This runs as the customer; /scripts/lib is root-only, so keep the
    // equivalent expression here. NginxUserHostsTest checks it against pmssMcxLabel.
    $canonicalId = ltrim($serviceId, '0');
    if ($canonicalId === '') $canonicalId = '0';
    $label = substr(hash('sha256', 'mcx.fi:service:'.$canonicalId), 0, 16);
    echo "  https://".$label.".mcx.fi/\n";
}
if ($withUsername) {
    if ($serverFqdn !== '') echo "  https://".$user.".".$serverFqdn."/\n";
    echo "\nEvery publicly trusted certificate is recorded in public Certificate Transparency logs.\n";
    echo "Anyone can search them, and the record is permanent. Including ".$user.".".$serverFqdn." publishes your username there for good.\n";
    echo "Requesting the default later does not remove it.\n";
    echo "Type yes to include your username, anything else cancels: ";
    $answer = fgets(STDIN);
    if ($answer === false || trim($answer) !== 'yes') {
        echo "Cancelled. Nothing was requested.\n";
        exit(1);
    }
} else {
    echo "\nThe certificate covers only this username-free name.\n";
    echo "The username hostname ".$user.".".$serverFqdn." stays on plain HTTP unless you rerun with --with-username-hostname.\n";
    echo "If you requested a username certificate before, this replaces it with one for the permalink only.\n";
    echo "Your username remains in the public logs from before.\n";
}

if (file_put_contents($home.'/.request-web-certs', $withUsername ? "username\n" : "default\n") === false) {
    fwrite(STDERR, "Could not record the request. Please open a support ticket.\n");
    exit(1);
}
@unlink($home.'/.request-web-certs.failed');

echo "Request recorded. Your certificate will normally be in place within a few\n";
echo "minutes. Re-run this command any time to check — once https:// loads\n";
echo "without a warning, you are done. Renewal is automatic afterwards.\n";
exit(0);
